@questId = 339e37a4-f9c7-408a-a128-c53067e77ab1


# ==============================================================================
# 🌐 1. INFRAESTRUTURA & HEALTHCHECK
# ==============================================================================

### 🟢 1.1 Ping (Status da API)
GET {{baseUrl}}/ping

### 🔴 1.2 Rota Inexistente (Fallback 404 Not Found)
GET {{baseUrl}}/rota-inexistente


# ==============================================================================
# 👤 2. AUTENTICAÇÃO (CADASTRO & LOGIN)
# ==============================================================================

### 🟢 2.1 Register — Usuário 1 (Sucesso - Retorna 201)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Novo Usuário",
  "email": "usuario@email.com",
  "password": "MinhaSenh@123"
}

### 🟢 2.2 Register — Usuário 2 (Sucesso - Retorna 201)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Segundo Usuário",
  "email": "usuario2@email.com",
  "password": "MinhaSenh@456"
}

### 🔴 2.3 Register — Email Duplicado (Retorna 409 Conflict)
# Execute duas vezes o cadastro com o mesmo email
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Novo Usuário",
  "email": "usuario@email.com",
  "password": "MinhaSenh@123"
}

### 🔴 2.4 Register — Erro de Validação Genérica (Retorna 400 Bad Request)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Ab",
  "email": "email-invalido",
  "password": "123"
}

### 🔴 2.5 Register — Erro Strict / Campo Extra Não Permitido (Retorna 400)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Admin",
  "email": "admin@email.com",
  "password": "MinhaSenh@123",
  "isAdmin": true
}

### 🟢 2.6 Login — Usuário 1 (Sucesso - Retorna 200 + Token)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "usuario@email.com",
  "password": "MinhaSenh@123"
}

### 🟢 2.7 Login — Usuário 2 (Sucesso - Retorna 200 + Token)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "usuario2@email.com",
  "password": "MinhaSenh@456"
}

### 🔴 2.8 Login — Credenciais Inválidas (Retorna 401 Unauthorized)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "usuario@email.com",
  "password": "SenhaErrada123!"
}

### 🔴 2.9 Login — Validação Zod / Campo Faltando (Retorna 400)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "password": "MinhaSenh@123"
}


# ==============================================================================
# ⚔️ 3. ROTAS PRIVADAS (QUESTS CRUD & FILTROS)
# ==============================================================================

### 🔵 3.1 Listar Todas as Quests do Usuário Logado
GET {{baseUrl}}/quests
Authorization: Bearer {{token}}

### 🟡 3.2 Criar Nova Quest (Sucesso - Retorna 201)
POST {{baseUrl}}/quests
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Aprender Persistência",
  "category": "estudo",
  "description": "Implementar o QuestJsonRepository na Sprint 6",
  "xp": 500,
  "difficulty": "medium"
}

### 🔴 3.3 Criar Quest — Erro de Validação (Retorna 400)
POST {{baseUrl}}/quests
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "A",
  "category": "estudo",
  "difficulty": "invalid_difficulty"
}

### 🔵 3.4 Obter Quest por ID (Sucesso)
GET {{baseUrl}}/quests/{{questId}}
Authorization: Bearer {{token}}

### 🔴 3.5 Obter Quest por ID Inexistente (Retorna 404)
GET {{baseUrl}}/quests/99999999-9999-9999-9999-999999999999
Authorization: Bearer {{token}}

### 🟡 3.6 Atualizar Quest (PUT - Sucesso)
PUT {{baseUrl}}/quests/{{questId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Aprender Persistência e PostgreSQL",
  "difficulty": "hard"
}

### 🟢 3.7 Completar Quest (PUT - Sucesso)
PUT {{baseUrl}}/quests/{{questId}}/complete
Authorization: Bearer {{token}}

### 🔴 3.8 Completar Quest já Concluída (Erro de Regra de Negócio - 400)
PUT {{baseUrl}}/quests/{{questId}}/complete
Authorization: Bearer {{token}}

### 🟣 3.9 Listar Quests com Filtro de Dificuldade
GET {{baseUrl}}/quests?difficulty=hard
Authorization: Bearer {{token}}

### 🟣 3.10 Listar Quests com Paginação
GET {{baseUrl}}/quests?page=1&limit=2
Authorization: Bearer {{token}}

### 🟣 3.11 Listar Quests com Filtros Combinados (Paginação + Status)
GET {{baseUrl}}/quests?completed=true&page=1&limit=5
Authorization: Bearer {{token}}

### 🟠 3.12 Deletar Quest (Soft Delete - Retorna 200/204)
DELETE {{baseUrl}}/quests/{{questId}}
Authorization: Bearer {{token}}


# ==============================================================================
# 🛡️ 4. SEGURANÇA: AUTORIZAÇÃO & ISOLAMENTO DE DADOS (MULTITENANCY)
# ==============================================================================

### 🔴 4.1 Buscar Quest do Usuário 1 usando Token do Usuário 2 (Espera 403 Forbidden)
GET {{baseUrl}}/quests/{{questId}}
Authorization: Bearer {{tokenUser2}}

### 🔴 4.2 Atualizar Quest do Usuário 1 usando Token do Usuário 2 (Espera 403 Forbidden)
PUT {{baseUrl}}/quests/{{questId}}
Authorization: Bearer {{tokenUser2}}
Content-Type: application/json

{
  "title": "Tentativa de invasão!"
}

### 🔴 4.3 Deletar Quest do Usuário 1 usando Token do Usuário 2 (Espera 403 Forbidden)
DELETE {{baseUrl}}/quests/{{questId}}
Authorization: Bearer {{tokenUser2}}

### 🟢 4.4 Listar Quests com Usuário 2 (Isolamento — Não vê quests do Usuário 1)
GET {{baseUrl}}/quests
Authorization: Bearer {{tokenUser2}}


# ==============================================================================
# 🛡️ 5. SEGURANÇA: CORS & PREFLIGHT
# ==============================================================================

### 🔵 5.1 Preflight OPTIONS — Origem Permitida (Retorna 200 + Headers CORS)
OPTIONS {{baseUrl}}/quests
Origin: http://localhost:5173
Access-Control-Request-Method: GET
Access-Control-Request-Headers: Authorization

### 🔴 5.2 Preflight OPTIONS — Origem Bloqueada (Erro de CORS)
OPTIONS {{baseUrl}}/quests
Origin: https://site-malicioso.com
Access-Control-Request-Method: GET


# ==============================================================================
# 🛡️ 6. SEGURANÇA: POLÍTICA DE SENHA FORTE (ZOD REGEX)
# ==============================================================================

### 🔴 6.1 Senha Fraca — Sem Letra Maiúscula (Espera 400)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Teste Senha",
  "email": "senha_fraca1@test.com",
  "password": "abcd1234!"
}

